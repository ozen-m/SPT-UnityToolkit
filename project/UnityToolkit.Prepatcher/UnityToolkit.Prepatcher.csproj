<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <CopyToOutputDir>$(MSBuildThisFileDirectory)CopyToOutput</CopyToOutputDir>
    <ProjectGuid>{B876D9D8-DF82-45DC-8B32-92BA269A8190}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <RootNamespace>UnityToolkit.Prepatcher</RootNamespace>
    <AssemblyName>UnityToolkit-Prepatcher</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Patcher.cs" />
    <Compile Include="Properties\AssemblyInfo.cs"/>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(SptSharedAssembliesDir)$(SptVersion)\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(SptSharedAssembliesDir)$(SptVersion)\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>$(SptSharedAssembliesDir)$(SptVersion)\Mono.Cecil.dll</HintPath>
    </Reference>
    <Reference Include="Mono.Cecil.Mdb">
      <HintPath>$(SptSharedAssembliesDir)$(SptVersion)\Mono.Cecil.Mdb.dll</HintPath>
    </Reference>
    <Reference Include="Mono.Cecil.Pdb">
      <HintPath>$(SptSharedAssembliesDir)$(SptVersion)\Mono.Cecil.Pdb.dll</HintPath>
    </Reference>
    <Reference Include="Mono.Cecil.Rocks">
      <HintPath>$(SptSharedAssembliesDir)$(SptVersion)\Mono.Cecil.Rocks.dll</HintPath>
    </Reference>
    <Reference Include="MonoMod.RuntimeDetour">
      <HintPath>$(SptSharedAssembliesDir)$(SptVersion)\MonoMod.RuntimeDetour.dll</HintPath>
    </Reference>
    <Reference Include="MonoMod.Utils">
      <HintPath>$(SptSharedAssembliesDir)$(SptVersion)\MonoMod.Utils.dll</HintPath>
    </Reference>
    <Reference Include="System" />
  </ItemGroup>
  <ItemGroup>
    <None Include="App.config" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
          Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')"/>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
  <Target Name="PostBuild" AfterTargets="Build;Rebuild" Condition=" '$(SkipDeploy)' != 'true' ">
    <Exec Command="if not exist &quot;$(SptBepInExPatchersDir)UnityToolkit&quot; (
    mkdir &quot;$(SptBepInExPatchersDir)UnityToolkit&quot;
    )

    copy &quot;$(TargetPath)&quot; &quot;$(SptBepInExPatchersDir)UnityToolkit\$(TargetName).dll&quot;
    xcopy /y /s &quot;$(CopyToOutputDir)&quot; &quot;$(SptBepInExPatchersDir)&quot;" />
  </Target>
  <Target Name="CreateReleaseZip" AfterTargets="PostBuild" Condition=" '$(SkipDeploy)' != 'true' ">
    <Exec Command="if not &quot;$(ConfigurationName)&quot;==&quot;Debug&quot; (
    cd /D &quot;$(SptBepInExPatchersDir)..\..\&quot;
    &quot;C:\Program Files\7-Zip\7z.exe&quot; a &quot;$(ReleaseArchive)&quot; &quot;BepInEx\patchers\UnityToolkit\*&quot;
    )" />
  </Target>
</Project>
